# ─── Database (Neon PostgreSQL) ───
# Pooled connection (used at runtime via PgBouncer)
DATABASE_URL="postgresql://user:password@ep-xxx-yyy-123.us-east-2.aws.neon.tech/dbname?sslmode=require"
# Direct connection (used for migrations / prisma db push)
DIRECT_URL="postgresql://user:password@ep-xxx-yyy-123.us-east-2.aws.neon.tech/dbname?sslmode=require"

# ─── OpenAI (poster generation) ───
PosterMaker_OPENAI_API_KEY="sk-..."

# ─── NextAuth ───
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# ─── Google OAuth (optional, for Google sign-in) ───
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Email (optional, for magic link sign-in) ───
# EMAIL_SERVER="smtp://user:pass@smtp.example.com:587"
# EMAIL_FROM="Poster Maker <noreply@postermaker.app>"

# ─── Stripe (payments) ───
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ─── Vercel Blob (image storage) ───
BLOB_READ_WRITE_TOKEN="vercel_blob_..."
